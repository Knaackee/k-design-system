{
  "name": "@k-design-system/ui",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editors": {
      "types": "./dist/editors/index.d.ts",
      "import": "./dist/editors/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./markdown.css": "./src/markdown.css",
    "./primitives/*": {
      "types": "./dist/primitives/*.d.ts",
      "import": "./dist/primitives/*.js"
    },
    "./actions/*": {
      "types": "./dist/actions/*.d.ts",
      "import": "./dist/actions/*.js"
    },
    "./charts/*": {
      "types": "./dist/charts/*.d.ts",
      "import": "./dist/charts/*.js"
    },
    "./chat/*": {
      "types": "./dist/chat/*.d.ts",
      "import": "./dist/chat/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "import": "./dist/data/*.js"
    },
    "./data-display/*": {
      "types": "./dist/data-display/*.d.ts",
      "import": "./dist/data-display/*.js"
    },
    "./feedback/*": {
      "types": "./dist/feedback/*.d.ts",
      "import": "./dist/feedback/*.js"
    },
    "./forms/*": {
      "types": "./dist/forms/*.d.ts",
      "import": "./dist/forms/*.js"
    },
    "./navigation/*": {
      "types": "./dist/navigation/*.d.ts",
      "import": "./dist/navigation/*.js"
    },
    "./overlays/*": {
      "types": "./dist/overlays/*.d.ts",
      "import": "./dist/overlays/*.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*.d.ts",
      "import": "./dist/patterns/*.js"
    },
    "./maps/*": {
      "types": "./dist/maps/*.d.ts",
      "import": "./dist/maps/*.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "import": "./dist/maps/index.js"
    },
    "./pickers/*": {
      "types": "./dist/pickers/*.d.ts",
      "import": "./dist/pickers/*.js"
    },
    "./basic-components": {
      "types": "./dist/basic-components.d.ts",
      "import": "./dist/basic-components.js"
    },
    "./extended-components": {
      "types": "./dist/extended-components.d.ts",
      "import": "./dist/extended-components.js"
    },
    "./styles.css": "./src/styles.css",
    "./core.css": "./src/core.css",
    "./forms.css": "./src/forms.css",
    "./actions.css": "./src/actions.css",
    "./overlays.css": "./src/overlays.css",
    "./basic-components.css": "./src/basic-components.css",
    "./localization": {
      "types": "./dist/localization/provider.d.ts",
      "import": "./dist/localization/provider.js"
    },
    "./adaptive": {
      "types": "./dist/adaptive.d.ts",
      "import": "./dist/adaptive.js"
    },
    "./editors/map-zone-editor": {
      "types": "./dist/editors/map-zone-editor.d.ts",
      "import": "./dist/editors/map-zone-editor.js"
    },
    "./map-zone-editor.css": "./src/editors/map-zone-editor.css",
    "./maps.css": "./src/patterns/map.css",
    "./map-day-view.css": "./src/patterns/map-day-view.css",
    "./map-location-picker.css": "./src/patterns/map-location-picker.css"
  },
  "files": [
    "dist",
    "src/**/*.css",
    "src/assets",
    "LICENSE.twemoji",
    "LICENSE.gemoji"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@k-design-system/tokens": "file:../tokens",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@svar-ui/react-gantt": "2.7.3",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@tanstack/table-core": "9.2.4",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "apple-liquid-glass-webgl": "^2.5.0",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "maplibre-gl": "6.15.0",
    "morphicons": "1.7.1",
    "motion": "^13.4.0",
    "polygon-clipping": "0.15.7",
    "qrcode": "1.5.4",
    "react-modal-sheet": "^5.6.0",
    "streamdown": "^2.6.0",
    "vis-timeline": "8.5.4",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsqr": "1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
