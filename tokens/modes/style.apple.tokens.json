{
  "component": {
    "list": {
      "rowMinHeight": {
        "$type": "dimension",
        "$value": "{size.scale.listRowRelaxed}"
      },
      "rowPaddingBlock": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "rowPaddingInline": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "leadingGap": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "groupRadius": {
        "$type": "dimension",
        "$value": "{radius.card}"
      },
      "sectionHeaderGap": {
        "$type": "dimension",
        "$value": "{space.2}"
      },
      "sectionHeaderInset": {
        "$type": "dimension",
        "$value": "{space.4}"
      }
    },
    "pageHeader": {
      "paddingBlockStart": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "titleGap": {
        "$type": "dimension",
        "$value": "{space.1}"
      }
    },
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.scale.full}"
      }
    },
    "metricCard": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.card}"
      }
    }
  },
  "size": {
    "controlTouch": {
      "$type": "dimension",
      "$value": "{size.control.lg}"
    },
    "fieldTouch": {
      "$type": "dimension",
      "$value": "{size.control.lg}"
    },
    "prominentTouch": {
      "$type": "dimension",
      "$value": "{size.control.prominent}"
    },
    "iconStroke": {
      "$type": "number",
      "$value": "{size.iconStroke.fine}"
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "{radius.scale.3xl}"
    }
  }
}
