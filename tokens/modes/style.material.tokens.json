{
  "component": {
    "topBar": {
      "height": {
        "$type": "dimension",
        "$value": "{size.scale.topBarMaterial}"
      }
    },
    "list": {
      "rowMinHeight": {
        "$type": "dimension",
        "$value": "{size.scale.listRowMaterial}"
      },
      "rowPaddingBlock": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "rowPaddingInline": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "leadingGap": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "groupRadius": {
        "$type": "dimension",
        "$value": "{radius.scale.3xl}"
      },
      "sectionHeaderGap": {
        "$type": "dimension",
        "$value": "{space.2}"
      },
      "sectionHeaderInset": {
        "$type": "dimension",
        "$value": "{space.4}"
      }
    },
    "pageHeader": {
      "paddingBlockStart": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "titleGap": {
        "$type": "dimension",
        "$value": "{space.1}"
      }
    },
    "button": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.scale.full}"
      }
    }
  },
  "size": {
    "controlTouch": {
      "$type": "dimension",
      "$value": "{size.control.comfortable}"
    },
    "fieldTouch": { "$type": "dimension", "$value": "{size.control.field}" },
    "prominentTouch": {
      "$type": "dimension",
      "$value": "{size.control.tall}"
    },
    "iconStroke": { "$type": "number", "$value": "{size.iconStroke.regular}" }
  }
}
