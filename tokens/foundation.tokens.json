{
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f7f8fa" },
      "100": { "$type": "color", "$value": "#eef0f4" },
      "300": { "$type": "color", "$value": "#c9cdd6" },
      "600": { "$type": "color", "$value": "#5d6472" },
      "900": { "$type": "color", "$value": "#15171c" },
      "950": { "$type": "color", "$value": "#0d0f12" }
    },
    "indigo": {
      "400": { "$type": "color", "$value": "#8b8cf8" },
      "500": { "$type": "color", "$value": "#696af0" },
      "600": { "$type": "color", "$value": "#5556d9" },
      "700": { "$type": "color", "$value": "#4546bd" }
    },
    "teal": {
      "300": { "$type": "color", "$value": "#5eead4" },
      "500": { "$type": "color", "$value": "#14b8a6" },
      "600": { "$type": "color", "$value": "#0d9488" },
      "700": { "$type": "color", "$value": "#0f766e" }
    }
  },
  "space": {
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
  },
  "size": {
    "control": {
      "md": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } }
    }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter, ui-sans-serif, system-ui, sans-serif"
      }
    },
    "size": {
      "body": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } }
    },
    "weight": {
      "medium": { "$type": "fontWeight", "$value": 500 }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": { "value": 80, "unit": "ms" } }
    }
  }
}
