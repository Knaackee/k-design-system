    "heading5": {
      "size": { "$type": "dimension", "$value": "{font.size.heading5Compact}" },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{font.lineHeight.heading5Compact}"
      },
      "letterSpacing": {
        "$type": "dimension",
        "$value": "{font.letterSpacing.heading5}"
