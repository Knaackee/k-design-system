    "heading6": {
      "size": { "$type": "dimension", "$value": "{font.size.heading6Compact}" },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{font.lineHeight.heading6Compact}"
      },
      "letterSpacing": {
        "$type": "dimension",
        "$value": "{font.letterSpacing.heading6}"
