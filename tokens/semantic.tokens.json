{
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "{color.neutral.50}" },
      "raised": { "$type": "color", "$value": "{color.neutral.0}" },
      "subtle": { "$type": "color", "$value": "{color.neutral.100}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.neutral.900}" },
      "muted": { "$type": "color", "$value": "{color.neutral.600}" }
    },
    "brand": {
      "primary": {
        "accent": { "$type": "color", "$value": "{color.indigo.600}" },
        "background": { "$type": "color", "$value": "{color.neutral.100}" },
        "foreground": { "$type": "color", "$value": "{color.indigo.700}" },
        "border": { "$type": "color", "$value": "{color.indigo.400}" }
      },
      "secondary": {
        "accent": { "$type": "color", "$value": "{color.violet.500}" },
        "background": { "$type": "color", "$value": "{color.violet.50}" },
        "foreground": { "$type": "color", "$value": "{color.violet.900}" },
        "border": { "$type": "color", "$value": "{color.violet.200}" }
      }
    },
    "status": {
      "info": {
        "accent": { "$type": "color", "$value": "{color.blue.500}" },
        "background": { "$type": "color", "$value": "{color.blue.50}" },
        "foreground": { "$type": "color", "$value": "{color.blue.900}" },
        "border": { "$type": "color", "$value": "{color.blue.200}" }
      },
      "success": {
        "accent": { "$type": "color", "$value": "{color.green.500}" },
        "background": { "$type": "color", "$value": "{color.green.50}" },
        "foreground": { "$type": "color", "$value": "{color.green.900}" },
        "border": { "$type": "color", "$value": "{color.green.200}" }
      },
      "warning": {
        "accent": { "$type": "color", "$value": "{color.amber.500}" },
        "background": { "$type": "color", "$value": "{color.amber.50}" },
        "foreground": { "$type": "color", "$value": "{color.amber.900}" },
        "border": { "$type": "color", "$value": "{color.amber.200}" }
      },
      "error": {
        "accent": { "$type": "color", "$value": "{color.red.500}" },
        "background": { "$type": "color", "$value": "{color.red.50}" },
        "foreground": { "$type": "color", "$value": "{color.red.900}" },
        "border": { "$type": "color", "$value": "{color.red.200}" }
      }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.300}" },
      "strong": { "$type": "color", "$value": "{color.neutral.600}" },
      "focus": { "$type": "color", "$value": "{color.indigo.400}" }
    },
    "action": {
      "primary": {
        "background": { "$type": "color", "$value": "{color.indigo.600}" },
        "hover": { "$type": "color", "$value": "{color.indigo.700}" },
        "pressed": { "$type": "color", "$value": "{color.indigo.700}" },
        "foreground": { "$type": "color", "$value": "{color.neutral.0}" }
      },
      "secondary": {
        "background": { "$type": "color", "$value": "{color.surface.raised}" },
        "hover": { "$type": "color", "$value": "{color.surface.subtle}" },
        "pressed": { "$type": "color", "$value": "{color.surface.canvas}" },
        "foreground": { "$type": "color", "$value": "{color.text.primary}" },
        "border": { "$type": "color", "$value": "{color.border.default}" }
      },
      "ghost": {
        "background": { "$type": "color", "$value": "#00000000" },
        "hover": { "$type": "color", "$value": "{color.surface.subtle}" },
        "pressed": { "$type": "color", "$value": "{color.surface.canvas}" },
        "foreground": { "$type": "color", "$value": "{color.text.muted}" },
        "border": { "$type": "color", "$value": "#00000000" }
      }
    }
  },
  "space": {
    "controlGap": { "$type": "dimension", "$value": "{space.2}" },
    "controlInsetInline": { "$type": "dimension", "$value": "{space.3}" },
    "layoutGutter": { "$type": "dimension", "$value": "{space.4}" },
    "layoutSectionGap": { "$type": "dimension", "$value": "{space.8}" },
    "cardPadding": { "$type": "dimension", "$value": "{space.4}" }
  },
  "size": {
    "control": { "$type": "dimension", "$value": "{size.control.md}" },
    "hitTarget": { "$type": "dimension", "$value": "{size.hitTarget.pointer}" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "{radius.scale.none}" },
    "small": { "$type": "dimension", "$value": "{radius.scale.sm}" },
    "medium": { "$type": "dimension", "$value": "{radius.scale.md}" },
    "large": { "$type": "dimension", "$value": "{radius.scale.lg}" },
    "extraLarge": { "$type": "dimension", "$value": "{radius.scale.xl}" },
    "full": { "$type": "dimension", "$value": "{radius.scale.full}" },
