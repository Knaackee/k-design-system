    "card": { "$type": "dimension", "$value": "{radius.scale.md}" },
    "overlay": { "$type": "dimension", "$value": "{radius.scale.lg}" }
  },
  "border": {
    "width": {
      "none": { "$type": "dimension", "$value": "{stroke.none}" },
      "default": { "$type": "dimension", "$value": "{stroke.default}" }
    }
  },
  "elevation": {
    "none": { "$type": "shadow", "$value": "{shadow.none}" },
    "low": { "$type": "shadow", "$value": "{shadow.low}" },
    "medium": { "$type": "shadow", "$value": "{shadow.medium}" },
    "overlay": { "$type": "shadow", "$value": "{shadow.overlay}" }
  },
